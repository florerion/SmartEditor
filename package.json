{
  "name": "smart-md-editor",
  "version": "0.7.3",
  "description": "WYSIWYG Markdown editor — split view, extensible toolbar, markdown-it powered",
  "type": "module",
  "main": "dist/smart-editor.cjs.js",
  "module": "dist/smart-editor.esm.js",
  "browser": "dist/smart-editor.iife.js",
  "exports": {
    ".": {
      "import": "./dist/smart-editor.esm.js",
      "require": "./dist/smart-editor.cjs.js"
    }
  },
  "bin": {
    "smart-md-editor": "./scripts/download-drawio.mjs"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "scripts/download-drawio.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florerion/SmartEditor.git"
  },
  "homepage": "https://florerion.github.io/SmartEditor/",
  "bugs": {
    "url": "https://github.com/florerion/SmartEditor/issues"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "drawio:download": "node scripts/download-drawio.mjs",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.10",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.1",
    "@codemirror/view": "^6.36.3",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.21",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "playwright": "^1.58.2",
    "rollup": "^4.34.9",
    "vitest": "^4.1.2"
  }
}
